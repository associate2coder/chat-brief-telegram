# Copy to .env (gitignored) and fill in real values. Never commit real values — this file is
# placeholders only. See src/config/index.ts for how each is read and validated.

# The Telegram bot's API token (from @BotFather). Required — the relay refuses to start
# without it (spec §6.1: fail closed on incomplete required config).
TELEGRAM_BOT_TOKEN=000000:AAAA-example-bot-token

# The Telegram chat id the relay delivers to (the owner's own chat with their bot). Required —
# same fail-closed rule as TELEGRAM_BOT_TOKEN.
TELEGRAM_CHAT_ID=000000000

# The shared secret the Custom GPT Action must present (via the X-Chat-Brief-Secret header,
# ADR-0001) on every call. Required — the relay refuses to start with this unset or empty
# (spec §6.1), and never treats an empty value as a valid match. Rotate by changing this value
# and redeploying (sad.md §4) — there is no rotation endpoint in v1.
CHAT_BRIEF_SHARED_SECRET=example-not-a-real-secret

# HTTP port the relay listens on. Optional — defaults to 3000.
PORT=3000

# Milliseconds the relay waits for Telegram's sendMessage response before treating the call as
# a delivery failure (spec §6 NFR). Optional — defaults to 5000.
TELEGRAM_TIMEOUT_MS=5000
